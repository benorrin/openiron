# Copy to .env and fill in before running `docker compose up`.

# Password for the bundled PostgreSQL database. Avoid ";" and spaces; it is placed in a connection string.
POSTGRES_PASSWORD=

# Secret used to sign login tokens. At least 32 characters; generate with `openssl rand -base64 48`.
JWT_SECRET=

# Port the web app is served on.
WEB_PORT=8080
