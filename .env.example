# Copy to .env and fill in before running `docker compose up`.

# Password for the bundled PostgreSQL database. Avoid ";" and spaces; it is placed in a connection string.
POSTGRES_PASSWORD=

# Secret used to sign login tokens. At least 32 characters; generate with `openssl rand -base64 48`.
JWT_SECRET=

# Optional: an account that is created (or promoted) as an admin when the API starts. The password is only
# used if the account doesn't exist yet, and can be removed from .env afterwards (at least 8 characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Port the web app is served on.
WEB_PORT=8080
